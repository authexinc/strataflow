<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!--
  The stock Odoo navbar, rebuilt as the shell's top bar.

  Every path out of the six fullscreen screens (`+ New ticket`, `+ New deal`, `Open in Odoo`,
  every smart button) lands the tenant on a stock page, and until now that page carried Odoo's
  own chrome: an apps grid, the app brand, the `ir.ui.menu` sections, a messaging systray and a
  company switcher. None of it belongs to this product. This template renders the same brand
  pill and nav pills the shell does (`strataflow_workorder.Shell`), so the two read as one app.

  Kept from stock, on purpose: `.o_navbar_breadcrumbs`, which the control panel portals its
  breadcrumb into on small screens, and the user-menu systray item, which is the only route to
  Preferences and Log out. Everything else in the systray is filtered out in navbar.js.
-->
<t t-name="strataflow_workorder.NavBar">
    <header class="o_navbar" t-ref="root">
        <nav class="o_main_navbar d-print-none" data-command-category="disabled">
            <div class="o_sf_pill o_sf_brand">
                <svg class="o_sf_logo" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 7.5c4-2.5 8 2.5 12 0s6-1.5 6-1.5" stroke="#f2b705" stroke-width="2" stroke-linecap="round"/>
                    <path d="M3 12.5c4-2.5 8 2.5 12 0s6-1.5 6-1.5" stroke="#de2d26" stroke-width="2" stroke-linecap="round"/>
                    <path d="M3 17.5c4-2.5 8 2.5 12 0s6-1.5 6-1.5" stroke="#0f6ed8" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span class="o_sf_brand_text">
                    <span class="o_sf_brand_name">Strataflow</span>
                    <span class="o_sf_brand_tag" aria-hidden="true">by Strataline</span>
                </span>
            </div>

            <nav class="o_sf_pill o_sf_nav" aria-label="Strataflow">
                <t t-foreach="sfNav" t-as="item" t-key="item.key">
                    <button type="button" class="o_sf_navbtn" t-att-class="{ 'is-on': item.key === sfActiveKey }"
                            t-att-aria-current="item.key === sfActiveKey ? 'page' : undefined"
                            t-on-click="() => this.sfGoNav(item.key)"><t t-esc="item.label"/></button>
                </t>
            </nav>

            <div class="o_navbar_breadcrumbs d-contents"/>
            <span class="o_sf_spacer"/>

            <div class="o_menu_systray d-flex flex-shrink-0 align-items-center" role="menu">
                <t t-foreach="systrayItems" t-as="item" t-key="item.key">
                    <ErrorHandler onError="error => this.handleItemError(error, item)">
                        <t t-component="item.Component" t-props="item.props"/>
                    </ErrorHandler>
                </t>
            </div>
        </nav>
    </header>
</t>

</templates>
