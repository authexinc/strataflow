<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="strataflow_workorder.Locator">
    <StrataflowShell active="'locator'" me="state.data.me" loading="state.loading" skeleton="'list'" bgmap="state.view === 'map' ? 'none' : 'grid'">
        <t t-set-slot="nav">
            <nav class="o_sf_pill o_sf_nav" aria-label="Locator view">
                <button type="button" class="o_sf_navbtn" t-att-class="{ 'is-on': state.view === 'route' }" t-att-aria-current="state.view === 'route' ? 'page' : undefined" t-on-click="() => { state.view = 'route'; state.mapFocus = false; }">My Route</button>
                <button type="button" class="o_sf_navbtn" t-att-class="{ 'is-on': state.view === 'map' }" t-att-aria-current="state.view === 'map' ? 'page' : undefined" t-on-click="() => (state.view = 'map')">Map</button>
            </nav>
        </t>
        <t t-set-slot="headerRight">
            <button type="button" class="o_sf_pill o_sf_pillbtn" t-on-click="() => this.action.doAction({ type: 'ir.actions.client', tag: 'strataflow_home' }, { clearBreadcrumbs: true })">← Office view</button>
        </t>

        <!-- MAP MODE: unobstructed map -->
        <t t-if="state.view === 'map'">
            <StratalineMap markers="markers" basemap="state.basemap" utilities="state.layers" focus="state.mapFocus ? state.selId : false" padding="constructor.MAP_PADDING" onSelect.bind="selectStop" onReady.bind="onMapReady">
                <span class="o_sf_bm o_sf_bm--top" role="group" aria-label="Basemap">
                    <button type="button" class="o_sf_bm_btn" t-att-class="{ 'is-on': state.basemap === 'streets' }" t-att-aria-pressed="state.basemap === 'streets'" t-on-click="() => (state.basemap = 'streets')">Map</button>
                    <button type="button" class="o_sf_bm_btn" t-att-class="{ 'is-on': state.basemap === 'satellite' }" t-att-aria-pressed="state.basemap === 'satellite'" t-on-click="() => (state.basemap = 'satellite')">Satellite</button>
                </span>
                <button t-if="sel" type="button" class="o_sf_btn o_sf_btn--primary o_sf_btn--float" t-on-click="() => { state.view = 'route'; state.mapFocus = false; }">← Back to ticket</button>
            </StratalineMap>
            <nav class="o_sf_rail" aria-label="Map controls">
                <button type="button" class="o_sf_rail_btn" title="Zoom in" t-on-click="() => this.zoom(1)">+</button>
                <button type="button" class="o_sf_rail_btn" title="Zoom out" t-on-click="() => this.zoom(-1)">−</button>
                <button type="button" class="o_sf_rail_btn" title="Utility layers" t-att-aria-pressed="state.layers" t-att-class="{ 'is-on': state.layers }" t-on-click="() => (state.layers = !state.layers)"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><polygon points="10,2 18,6.5 10,11 2,6.5"/><polyline points="2,10.5 10,15 18,10.5"/><polyline points="2,14.5 10,19 18,14.5"/></svg></button>
            </nav>
        </t>

        <!-- ROUTE MODE -->
        <div t-else="" class="o_sf_body">
            <aside t-if="state.panelOpen" class="o_sf_panel o_sf_route" aria-label="My route">
                <div class="o_sf_route_head">
                    <span><span class="o_sf_eyebrow">Today</span><span class="o_sf_note o_sf_route_sub"><t t-esc="stops.length"/> stops</span></span>
                    <button type="button" class="o_sf_x" title="Collapse panel" aria-label="Collapse panel" t-on-click="() => (state.panelOpen = false)">‹</button>
                </div>
                <div class="o_sf_rows">
                    <p t-if="!stops.length" class="o_sf_empty">No tickets on the route yet — dispatch assigns them.</p>
                    <t t-foreach="stops" t-as="s" t-key="s.id">
                        <button type="button" class="o_sf_row o_sf_row--stop" t-att-class="{ 'is-selected': s.id === state.selId }" t-on-click="() => this.selectStop(s.id)">
                            <span class="o_sf_stop_n o_sf_mono" t-att-class="{ 'is-done': s.done }" t-esc="s.n"/>
                            <span class="o_sf_row_text"><b t-esc="s.address"/><small class="o_sf_mono" t-esc="s.meta"/></span>
                            <span class="o_sf_status" t-attf-class="o_sf_status--{{ s.stopStatus }}" t-esc="s.stopLabel"/>
                        </button>
                    </t>
                </div>
                <div class="o_sf_list_foot" t-esc="routeFoot"/>
            </aside>

            <section class="o_sf_panel o_sf_detail" t-if="sel">
                <div class="o_sf_detail_head o_sf_detail_head--loc">
                    <button t-if="!state.panelOpen" type="button" class="o_sf_x" title="Show route" aria-label="Show route" t-on-click="() => (state.panelOpen = true)">›</button>
                    <span class="o_sf_detail_title">
                        <span class="o_sf_eyebrow o_sf_mono o_sf_eyebrow--accent"><t t-esc="sel.name"/> · dig <t t-esc="fmtDate(sel.dig_date)"/><t t-if="sel.emergency"> · <span class="o_sf_danger_text">EMERGENCY</span></t></span>
                        <span class="o_sf_h1" t-esc="sel.address"/>
                    </span>
                    <span class="o_sf_steps" aria-label="Progress">
                        <t t-foreach="steps" t-as="stp" t-key="stp.key"><span class="o_sf_step" t-att-class="{ 'is-on': stp.on, 'is-done': stp.done }" t-esc="stp.label"/></t>
                    </span>
                    <span class="o_sf_utils"><t t-foreach="selUtilities" t-as="u" t-key="u.id"><span class="o_sf_util"><span class="o_sf_dot" t-attf-style="background: {{ u.color }}" aria-hidden="true"/><t t-esc="u.name"/></span></t></span>
                </div>

                <!-- COMPLETED: the locate is in; show the ticket, not the tools -->
                <t t-if="selDone">
                    <t t-call="strataflow_workorder.LocateReviewBody"/>
                    <div class="o_sf_stage_actions">
                        <span class="o_sf_status o_sf_status--located o_sf_status--lg" t-esc="doneLabel"/>
                        <span class="o_sf_note" t-esc="completedNote"/>
                        <span class="o_sf_spacer"/>
                        <button t-if="nextOpenStop" type="button" class="o_sf_btn o_sf_btn--primary" t-on-click="() => this.selectStop(this.nextOpenStop.id)">Next stop →</button>
                    </div>
                </t>

                <!-- STAGE 1: on-site map -->
                <t t-elif="state.stage === 'map'">
                    <div class="o_sf_site">
                        <div class="o_sf_canvas o_sf_canvas--site" t-att-class="{ 'is-satellite': state.basemap === 'satellite' }">
                            <StratalineMap markers="siteMarkers" basemap="state.basemap" zoom="16" padding="constructor.SITE_PADDING" onReady.bind="onMapReady"/>
                            <span class="o_sf_bm" role="group" aria-label="Basemap">
                                <button type="button" class="o_sf_bm_btn" t-att-class="{ 'is-on': state.basemap === 'streets' }" t-on-click="() => (state.basemap = 'streets')">Map</button>
                                <button type="button" class="o_sf_bm_btn" t-att-class="{ 'is-on': state.basemap === 'satellite' }" t-on-click="() => (state.basemap = 'satellite')">Satellite</button>
                            </span>
                            <div class="o_sf_site_card">
                                <div class="o_sf_eyebrow">Strataline · at this address</div>
                                <t t-foreach="selUtilities" t-as="u" t-key="u.id">
                                    <div class="o_sf_site_row"><span class="o_sf_dot" t-attf-style="background: {{ u.color }}" aria-hidden="true"/><span t-esc="u.name"/><span class="o_sf_status o_sf_status--located">on ticket</span></div>
                                </t>
                                <div class="o_sf_site_row"><span class="o_sf_dot o_sf_dot--cadastral" aria-hidden="true"/><span>Property lines · cadastral</span><span class="o_sf_status">layer on</span></div>
                                <div class="o_sf_note o_sf_mt-s">Utility lines are Strataline's live layer at this address — verify on-site records before digging clearance.</div>
                                <button type="button" class="o_sf_chip o_sf_chip--wide" t-on-click="() => (state.detailsOpen = !state.detailsOpen)" t-att-aria-expanded="state.detailsOpen"><t t-esc="state.detailsOpen ? 'Hide details' : 'View all details'"/></button>
                                <dl t-if="state.detailsOpen" class="o_sf_kv o_sf_kv--card">
                                    <dt>Requested by</dt><dd class="o_sf_mono" t-esc="sel.requester || '—'"/>
                                    <dt>Source</dt><dd class="o_sf_mono" t-esc="sel.source"/>
                                    <dt>Priority</dt><dd class="o_sf_mono" t-att-class="{ 'o_sf_danger_text': sel.emergency }" t-esc="sel.emergency ? 'EMERGENCY' : 'Standard'"/>
                                    <dt>Contact</dt><dd class="o_sf_mono" t-esc="sel.contact || '—'"/>
                                    <dt>Parcel</dt><dd class="o_sf_mono" t-esc="sel.parcel || '—'"/>
                                    <dt class="o_sf_kv_top">Scope note</dt><dd t-esc="sel.scope_note || '—'"/>
                                </dl>
                            </div>
                        </div>
                    </div>
                    <div class="o_sf_stage_actions">
                        <button type="button" class="o_sf_btn" t-on-click="navigate">Navigate ↗</button>
                        <button type="button" class="o_sf_btn" t-on-click="() => { state.view = 'map'; state.mapFocus = true; }">Open in map ↗</button>
                        <button t-if="sel.status === 'assigned'" type="button" class="o_sf_btn" t-on-click="markOnSite">I'm on site</button>
                        <span class="o_sf_spacer"/>
                        <span class="o_sf_note">Locate on site first, then draw it up</span>
                        <button type="button" class="o_sf_btn o_sf_btn--primary" t-on-click="() => (state.stage = 'draw')">Start locate drawing →</button>
                    </div>
                </t>

                <!-- STAGE 2: drawing -->
                <t t-elif="state.stage === 'draw'">
                    <div class="o_sf_site o_sf_site--draw">
                        <LocateCanvas utilities="state.data.utilities" drawing="sel.drawing" onChange.bind="onDrawingChange" t-key="sel.id"/>
                        <div t-if="state.auditOpen" class="o_sf_audit" role="status">
                            <div class="o_sf_audit_head"><span class="o_sf_eyebrow">Auto audit</span><span class="o_sf_spacer"/><button type="button" class="o_sf_x o_sf_x--sm" aria-label="Close audit" t-on-click="() => (state.auditOpen = false)">✕</button></div>
                            <t t-foreach="audit" t-as="f" t-key="f_index"><div class="o_sf_finding"><span class="o_sf_dot" t-attf-class="o_sf_dot--f-{{ f.level }}" aria-hidden="true"/><span t-esc="f.text"/></div></t>
                        </div>
                    </div>
                    <div class="o_sf_stage_actions">
                        <button type="button" class="o_sf_btn" t-on-click="() => { state.stage = 'map'; state.auditOpen = false; }">← Back to site</button>
                        <button type="button" class="o_sf_btn" t-on-click="runAudit">Run audit</button>
                        <span class="o_sf_spacer"/>
                        <button type="button" class="o_sf_btn o_sf_btn--primary" t-on-click="toReview">Review &amp; confirm →</button>
                    </div>
                </t>

                <!-- STAGE 3: review + confirm -->
                <t t-else="">
                    <t t-call="strataflow_workorder.LocateReviewBody"/>
                    <div class="o_sf_stage_actions">
                        <button type="button" class="o_sf_btn" t-on-click="() => { state.stage = 'draw'; state.auditOpen = false; }">← Back to drawing</button>
                        <span class="o_sf_spacer"/>
                        <button type="button" class="o_sf_btn o_sf_btn--primary" t-att-disabled="!hasLines" t-on-click="confirmLocate">Confirm locate</button>
                    </div>
                </t>
            </section>
            <section class="o_sf_panel o_sf_detail o_sf_detail--empty" t-else=""><p class="o_sf_empty">No ticket selected.</p></section>
        </div>

        <t t-set-slot="footer" t-if="state.view === 'map'">
            <span class="o_sf_pill o_sf_pill--sm o_sf_pill--danger"><svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><g transform="translate(0 -1.4)"><path d="M10 3 L18 17 H2 Z" stroke-linejoin="round"/><line x1="10" y1="8.5" x2="10" y2="12.5"/><circle cx="10" cy="14.8" r="0.7" fill="currentColor" stroke="none"/></g></svg>Reference only — not a locate</span>
        </t>
    </StrataflowShell>
</t>

<t t-name="strataflow_workorder.LocateReviewBody">
                    <div class="o_sf_review">
                        <div>
                            <div class="o_sf_eyebrow" t-esc="selDone ? 'Ticket details' : 'Confirm ticket details'"/>
                            <dl class="o_sf_kv">
                                <dt>Ticket</dt><dd class="o_sf_mono" t-esc="sel.name"/>
                                <dt>Address</dt><dd class="o_sf_mono" t-esc="sel.address"/>
                                <dt>Parcel</dt><dd class="o_sf_mono" t-esc="sel.parcel || '—'"/>
                                <dt>Located by</dt><dd class="o_sf_mono"><t t-esc="sel.locator ? sel.locator.name : state.data.me.name"/><t t-if="sel.onsite_at"> · on site <t t-esc="fmtWhen(sel.onsite_at)"/></t></dd>
                                <dt>GPS</dt><dd class="o_sf_mono" t-esc="sel.latitude ? sel.latitude.toFixed(4) + ', ' + sel.longitude.toFixed(4) + ' · ticket address' : '— no fix'"/>
                            </dl>
                            <div class="o_sf_eyebrow o_sf_eyebrow--gap">Locate print · drawn lines</div>
                            <div t-if="hasLines" class="o_sf_lines">
                                <t t-foreach="lines.rows" t-as="lr" t-key="lr.code"><div class="o_sf_line_row"><span class="o_sf_dot" t-attf-style="background: {{ lr.color }}" aria-hidden="true"/><span><t t-esc="lr.name"/> · <t t-esc="lr.count"/> line(s)</span><span class="o_sf_mono" t-esc="lr.metres.toFixed(1) + ' m'"/></div></t>
                                <div class="o_sf_line_row o_sf_line_row--total"><span class="o_sf_eyebrow">Total marked · <t t-esc="(sel.drawing.notes || []).length"/> notes</span><span class="o_sf_mono" t-esc="lines.total.toFixed(1) + ' m'"/></div>
                            </div>
                            <p t-elif="selDone" class="o_sf_note">No lines were drawn on this ticket.</p>
                            <p t-else="" class="o_sf_note o_sf_danger_text">No lines drawn yet — go back and draw the locate before confirming.</p>
                            <div class="o_sf_eyebrow o_sf_eyebrow--gap">Documents</div>
                            <div class="o_sf_docs">
                                <p t-if="!state.attachments.length" class="o_sf_note">No documents on this ticket yet.</p>
                                <t t-foreach="state.attachments" t-as="a" t-key="a.id">
                                    <div class="o_sf_doc"><span class="o_sf_doc_name" t-esc="a.name"/><span class="o_sf_note o_sf_mono" t-esc="fmtWhen(a.create_date)"/><button type="button" class="o_sf_chip" t-on-click="() => this.openAttachment(a)">View</button></div>
                                </t>
                                <input type="file" t-ref="file" multiple="multiple" hidden="hidden" t-on-change="upload"/>
                                <button type="button" class="o_sf_chip o_sf_chip--wide" t-att-disabled="state.uploading" t-on-click="pickFile"><t t-esc="state.uploading ? 'Uploading…' : 'Upload completed docs'"/></button>
                            </div>
                        </div>
                        <div>
                            <div class="o_sf_eyebrow">Locate print preview</div>
                            <div class="o_sf_preview_box">
                                <LocatePreview drawing="sel.drawing" utilities="state.data.utilities"/>
                                <span class="o_sf_canvas_cap o_sf_mono"><t t-esc="sel.name"/> · locate print · 1 px ≈ 0.15 m</span>
                            </div>
                            <div class="o_sf_audit_head o_sf_mt"><span class="o_sf_eyebrow">Auto audit</span><span class="o_sf_spacer"/><button type="button" class="o_sf_chip" t-on-click="runAudit">Re-run</button></div>
                            <div class="o_sf_findings"><t t-foreach="audit" t-as="f" t-key="f_index"><div class="o_sf_finding"><span class="o_sf_dot" t-attf-class="o_sf_dot--f-{{ f.level }}" aria-hidden="true"/><span t-esc="f.text"/></div></t></div>
                            <p class="o_sf_note">Rule-based check against ticket scope and typical measurement ranges. Findings are advisory — the locator's judgment governs.</p>
                        </div>
                    </div>
</t>

</templates>
