<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="strataflow_workorder.Home">
    <StrataflowShell active="'home'" me="state.me" loading="state.loading" skeleton="'grid'" bgmap="'home'" scroll="true" searchPlaceholder="'Tickets, records, addresses…'" locatorLink="state.me.is_dispatcher">
        <main class="o_sf_home">
            <div class="o_sf_home_date" t-esc="dateLine"/>
            <h1 class="o_sf_home_h1" t-esc="greeting"/>
            <div class="o_sf_home_chips">
                <t t-foreach="chips" t-as="c" t-key="c.key">
                    <span class="o_sf_pill o_sf_pill--sm" t-att-class="{ 'o_sf_pill--danger': c.danger }">
                        <span t-if="c.dot" class="o_sf_dot" t-attf-class="o_sf_dot--{{ c.dot }}" aria-hidden="true"/><t t-esc="c.label"/>
                    </span>
                </t>
            </div>
            <div class="o_sf_apps">
                <t t-foreach="apps" t-as="app" t-key="app.key">
                    <button type="button" class="o_sf_app" t-att-class="{ 'is-soon': app.soon }" t-attf-style="--hue: {{ app.hue }}" t-on-click="() => this.open(app)">
                        <span class="o_sf_app_icon" aria-hidden="true">
                            <svg t-if="app.icon === 'dispatch'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M10 18 C10 18 4 11.8 4 7.8 A6 6 0 0 1 16 7.8 C16 11.8 10 18 10 18 Z"/><circle cx="10" cy="7.8" r="2.2"/></svg>
                            <svg t-elif="app.icon === 'wo'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="4" y="3" width="12" height="15" rx="2"/><line x1="7.5" y1="7.5" x2="12.5" y2="7.5"/><line x1="7.5" y1="10.5" x2="12.5" y2="10.5"/><line x1="7.5" y1="13.5" x2="10.5" y2="13.5"/></svg>
                            <svg t-elif="app.icon === 'crm'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M3 4 H17 L12 10.5 V16 L8 17.5 V10.5 Z"/></svg>
                            <svg t-elif="app.icon === 'inv'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M5 2.5 H15 V17.5 L13 16.2 L11 17.5 L9 16.2 L7 17.5 L5 16.2 Z"/><line x1="8" y1="7" x2="12" y2="7"/><line x1="8" y1="10" x2="12" y2="10"/></svg>
                            <svg t-elif="app.icon === 'loc'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10" cy="10" r="5.5"/><circle cx="10" cy="10" r="1.6" fill="currentColor" stroke="none"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="10" y1="16" x2="10" y2="19"/><line x1="1" y1="10" x2="4" y2="10"/><line x1="16" y1="10" x2="19" y2="10"/></svg>
                            <svg t-elif="app.icon === 'equip'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M10 2.5 L17 6.25 V13.75 L10 17.5 L3 13.75 V6.25 Z"/><polyline points="3,6.25 10,10 17,6.25"/><line x1="10" y1="10" x2="10" y2="17.5"/></svg>
                            <svg t-elif="app.icon === 'time'" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10" cy="10" r="7.5"/><polyline points="10,5.5 10,10 13.5,12"/></svg>
                            <svg t-else="" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="4" y1="16" x2="4" y2="10"/><line x1="8" y1="16" x2="8" y2="5"/><line x1="12" y1="16" x2="12" y2="8"/><line x1="16" y1="16" x2="16" y2="3.5"/></svg>
                        </span>
                        <span class="o_sf_app_name" t-esc="app.name"/>
                        <span class="o_sf_app_stat" t-esc="app.stat"/>
                    </button>
                </t>
            </div>
        </main>
        <t t-set-slot="footer">
            <button type="button" class="o_sf_pill o_sf_pill--sm o_sf_pill--danger o_sf_pillbtn" t-on-click="disclaimer">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><g transform="translate(0 -1.4)"><path d="M10 3 L18 17 H2 Z" stroke-linejoin="round"/><line x1="10" y1="8.5" x2="10" y2="12.5"/><circle cx="10" cy="14.8" r="0.7" fill="currentColor" stroke="none"/></g></svg>
                Reference only — not a locate
            </button>
            <span class="o_sf_pill o_sf_pill--sm"><span class="o_sf_dot o_sf_dot--closed" aria-hidden="true"/>USP feed · not connected · manual entry</span>
        </t>
    </StrataflowShell>
</t>

</templates>
