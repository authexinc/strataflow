<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_strataflow" model="ir.module.category">
        <field name="name">Strataflow</field>
        <field name="sequence">25</field>
    </record>
    <record id="res_groups_privilege_strataflow" model="res.groups.privilege">
        <field name="name">Strataflow</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_strataflow"/>
    </record>
    <record id="group_strataflow_user" model="res.groups">
        <field name="name">Locator</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_strataflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees and works the locate tickets assigned to the crew; draws locate prints.</field>
    </record>
    <record id="group_strataflow_manager" model="res.groups">
        <field name="name">Dispatcher</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_strataflow"/>
        <field name="implied_ids" eval="[(4, ref('group_strataflow_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Assigns locators, closes tickets, manages utilities and records.</field>
    </record>
</odoo>
