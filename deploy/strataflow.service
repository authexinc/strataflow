[Unit]
Description=StrataFlow (Odoo 19)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=strataflow
Group=strataflow
WorkingDirectory=/opt/strataflow
ExecStart=/opt/strataflow/.venv/bin/python /opt/strataflow/odoo-bin -c /etc/strataflow/odoo.conf
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
